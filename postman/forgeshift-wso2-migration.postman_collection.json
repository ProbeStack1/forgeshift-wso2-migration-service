    {
      "name": "3 · Async + poll",
      "description": "Any POST supports `?async=true` — it returns immediately with a PENDING job. This shows the follow-up flow.",
      "item": [
        {
          "name": "Start (async) — Migrate API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"{{companyName}}\",\n  \"wso2Tenant\": \"{{wso2Tenant}}\",\n  \"userEmail\": \"{{userEmail}}\",\n  \"requestSource\": \"{{requestSource}}\",\n  \"requestTransactionId\": \"{{txnId}}\",\n  \"kongCtrlPlanId\": \"{{kongCtrlPlanId}}\",\n  \"kongRegion\": \"{{kongRegion}}\",\n  \"apis\": [\n    \"{{apiSourceId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/konnect/wso2/apis?async=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "konnect",
                "wso2",
                "apis"
              ],
              "query": [
                {
                  "key": "async",
                  "value": "true"
                }
              ]
            },
            "description": "Returns `201` with `{ id, state: \"PENDING\" }`. **Tip:** in the *Tests* tab add `pm.collectionVariables.set(\"migrationJobId\", pm.response.json().id)` to auto-fill the job id for the next two calls."
          },
          "response": []
        },
        {
          "name": "Poll status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/migrations/{{migrationJobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "migrations",
                "{{migrationJobId}}"
              ]
            },
            "description": "Repeat until `state` is `COMPLETED` / `FAILED` / `DRY_RUN_DONE`."
