SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8083

# --- MongoDB (same Atlas DB as discovery + profile-config) ---
MONGODB_URI=mongodb://localhost:27017/forgeshift_migration
MONGODB_DATABASE=forgeshift_migration

# --- Konnect fallback (used only when no profile exists in profiles collection) ---
KONNECT_BASE_URL=https://us.api.konghq.com
KONNECT_ACCESS_TOKEN=
KONNECT_CONTROL_PLANE_ID=
KONNECT_TRUST_SELF_SIGNED=false

# --- Translation tuning ---
TRANSLATION_DEFAULT_THROTTLE_RPM=10000
TRANSLATION_DEFAULT_TIMEOUT_MS=60000

# --- Multi-tenancy ---
TENANT_HEADER=X-Partner-Id
DEFAULT_TENANT=probestack

# --- Google Cloud Storage (reads the assessment-staged API JSON as a 3rd source) ---
# Reuses the SAME service account as the assessment service. Mount that SA key into
# credentials/firestore-credentials.json at runtime (gitignored, never committed).
# Leave GCS_CREDENTIALS_LOCATION unset to fall back to Application Default Credentials.
# Defaults below are baked into application.yml — override here only if they differ.
GCS_ENABLED=true
GCS_CREDENTIALS_LOCATION=file:credentials/firestore-credentials.json
GCS_PROJECT_ID=your-project-id
GCS_DEFAULT_BUCKET_NAME=run-sources-probestack-e2068-us-central1
GCS_MIGRATION_BUCKET_NAME=run-sources-probestack-e2068-us-central1
